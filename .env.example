GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TIMEFRAME=60
SYMBOL=OANDA:XAUUSD
AUTO_SEND_PLAN=false

# MT5 Bridge & Trade Execution Configuration
MT5_PORT=3000
AUTO_EXECUTE=true
DEFAULT_LOT=0.01
MAX_LOT=0.02
MAX_TOTAL_LOT=0.02
MAX_CONCURRENT_TRADES=1
ALLOW_CONCURRENT_TRADES=false
FIXED_SL_USD=15.0
FIXED_TP_USD=30.0
AUTO_CLOSE_PROFIT_USD=0.0
BREAKEVEN_TRIGGER_USD=10.0
BREAKEVEN_OFFSET_USD=1.0
LOT_MODE=FIXED
RISK_MIN_RR=1.8
RISK_MAX_SL_USD=30.0
RISK_MIN_SL_USD=8.0
TRADE_COOLDOWN_MINUTES=15
MT5_MAGIC_NUMBER=888999

# Kaufman Theory of Runs — Cooldown bảo vệ sau chuỗi thua liên tiếp
MAX_CONSECUTIVE_LOSSES=3
LOSS_COOLDOWN_MINUTES=30

# ICT Volume Management — Quản lý vốn động theo equity thực tế (Chương XIII)
DYNAMIC_RISK_ENABLED=false
DYNAMIC_RISK_BASE=0.5
DYNAMIC_RISK_HIGH=1.0
DYNAMIC_RISK_LOW=0.25
DYNAMIC_RISK_UP_THRESHOLD=2.0
DYNAMIC_RISK_DOWN_THRESHOLD=2.0

# Account Protection & Circuit Breaker (Bảo vệ vốn & Ngắt mạch khẩn cấp)
INITIAL_CAPITAL_USD=1000.0
MAX_ACCOUNT_LOSS_USD=300.0
MAX_DRAWDOWN_PERCENT=30.0
EMERGENCY_STOP_ENABLED=true
CLOSE_ALL_ON_EMERGENCY=true

# Trading Mode Configuration (Chuyển sang Hold dài H1/H4)
ENABLE_SCALP=false
ENABLE_HOLD=true

# M1 Continuous Scalping Feature (Đánh Scalp liên tục khung M1: TP 2-3 giá, SL 7 giá)
ENABLE_SCALP_M1=false
SCALP_M1_TP_USD=2.5
SCALP_M1_SL_USD=7.0
SCALP_M1_INTERVAL_SEC=60

# Advanced Trend Filter & Scan Schedule (Lọc xu hướng & Giãn chu kỳ quét)
ENFORCE_TREND_ALIGNMENT=true
AUTO_CLOSE_ON_TREND_REVERSAL=true
SCAN_INTERVAL_MINUTES=15

# Telegram Signal Copier (Userbot lắng nghe tự động từ nhóm kín)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_TARGET_CHANNELS=
